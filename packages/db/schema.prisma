datasource db {
  provider = "postgresql"
}

generator client_web {
  provider = "prisma-client-js"
  output   = "../../apps/web/prisma/src/generated/prisma"
}

generator client_api {
  provider = "prisma-client-js"
  output   = "../../apps/api/src/generated/prisma"
}

generator zod {
  provider = "zod-prisma-types"
}

model User {
  id   String  @id @default(cuid())
  name String?

  /// @zod.string.email({ message: "Invalid email."})
  email         String    @unique
  emailVerified DateTime?

  /// @zod.string.url({ message: "Invalid URL format." })
  image     String?
  password  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  accounts  Account[]
  sessions  Session[]

  ownedProjects  Project[]       @relation("OwnedProjects")
  projectMembers ProjectMember[]
}

model Project {
  id     String  @id @default(cuid())
  public Boolean @default(true)

  /// @zod.string.min(3, { message: "Project name too short." }).max(50, { message: "Project name too long."})
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ownerId   String

  owner User @relation("OwnedProjects", fields: [ownerId], references: [id])

  members ProjectMember[]
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(VIEWER)
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

enum ProjectRole {
  OWNER
  EDITOR
  VIEWER
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
